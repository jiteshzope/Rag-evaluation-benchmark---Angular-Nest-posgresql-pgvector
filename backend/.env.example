# ---- secrets ----
OPENAI_API_KEY=sk-...

# ---- server ----
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ---- models ----
EMBEDDING_MODEL=text-embedding-3-small
ANSWER_MODEL=gpt-5-nano
JUDGE_MODEL=gpt-5-nano
UTILITY_MODEL=gpt-5-nano

# ---- pgvector (stores ONLY the pre-embedded default knowledge base) ----
# Local, via docker compose:
DATABASE_URL=postgresql://rag:rag@localhost:5434/ragbench

# Neon: use the POOLED endpoint here — the "-pooler" host — and keep
# sslmode=require. Neon suspends an idle database, so the driver is configured
# to wait for it to wake rather than falling back to re-embedding the corpus.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ragbench?sslmode=require

# Migrations only. Point this at the DIRECT (non-pooled) Neon endpoint: the
# migration runner holds a session advisory lock so two deploys cannot apply the
# same file twice, and PgBouncer in transaction mode does not keep session state
# between statements. Unset locally — DATABASE_URL is then used for both.
# MIGRATION_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/ragbench?sslmode=require

# How long to wait for a connection. The default suits a serverless database
# resuming from suspend; lower it for a database that is always warm.
# PG_CONNECT_TIMEOUT_MS=20000

# ---- corpus paths ----
DEFAULT_KB_DIR=../default-knowledge-base
DEFAULT_QA_SET=../default-question-answer-set.jsonl
