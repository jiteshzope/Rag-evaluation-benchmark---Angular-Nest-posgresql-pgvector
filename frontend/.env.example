# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# On Vercel, add the same variable under Settings → Environment Variables and
# apply it to Production, Preview and Development.


# ── NG_APP_API_BASE_URL ──────────────────────────────────────────────────────
#
# Origin of the NestJS backend. Origin only: no trailing slash, and no /api
# suffix — the client appends that itself.
#
# It is read at BUILD time, not at run time: the value is compiled into the
# bundle, so changing it in Vercel does not affect a deployment that is already
# built. Redeploy after changing it.
#
# Leave it set to an empty value only if the UI and the API are served from the
# same origin, which makes every request relative.
#
# Locally this is the NestJS API started by `npm run dev` from the repo root.
# The deployed UI points at the hosted API instead:
#
#   NG_APP_API_BASE_URL=https://ragbenchbackend-production.up.railway.app

NG_APP_API_BASE_URL=http://localhost:3001
